<html>
<head>
<title>Registration Form</title>
</head>

<body>
<h1>Registration - Form Validation</h1>

<form name="form" action=" " onsubmit="return validateForm()">
<label for="name">Name :</label>
<select name="init" id="init">
   <option value="SLCT">Select</option>
   <option value="MR">Mr.</option>
   <option value="MS">Ms.</option>
   <option value="MRS">Mrs.</option>
</select>
<input type="text" id="fname" name="fname" placeholder="Enter your Name"><br><br>
<label for="phone">Phone : </label>
<select name="code" id="code">
   <option value="slct">Select</option>
   <option value="+91">+91</option>
   <option value="+971">+971</option>
   <option value="+966">+966</option>
   <option value="944">+944</option>
</select>
<input type="tel" id="mob" name="mob" placeholder="Enter Mobile Number"><br><br>
<label for="email">Email : </label>
<input type="email" id="email" name="email" placeholder="Enter Email"><br><br>
<label for="gender">Gender</label>
<input type="radio" id="male" name="gender"><label for="male">Male</label>
<input type="radio" id="female" name="gender"><label for="female">Female</label>
<input type="radio" id="others" name="gender"><label for="others">Others</label><br><br>
<label for="lang">Languages Known</label>
<input type="checkbox" id="eng" name="lang"><label>English</label>
<input type="checkbox" id="mal" name="lang"><label>Malayalam</label>
<input type="checkbox" id="hin" name="lang"><label>Hindi</label><br><br>
<label for="password">Password</label>
<input type="password" id="pass" name="pass" placeholder="Enter pasword"><br><br>
<label for="confpassword">Confirm Password</label>
<input type="text" id="confpass" name="confpass" placeholder="Enter pasword again"><br><br>
<button type="submit">Submit</button>
</form>

<script>
function validateForm() {
 var fname = document.form.fname.value.trim();
 var mob = document.form.mob.value.trim();
 var email = document.form.email.value.trim();
 var gender = document.querySelector('input[name="gender"]:checked');
 var lang = document.querySelectorAll('input[name="lang"]:checked');
 var pass = document.form.pass.value.trim();
 var confpass = document.form.confpass.value.trim();
 
 if(fname == ""){
    alert("Enter your Name");
    document.form.fname.focus();
    return false;
 }
 else if(!/^[a-zA-Z]+$/.test(fname)){
    alert("Enter valid Name");
    document.form.fname.focus();
    return false;
 }
 
 if(mob == ""){
    alert("Enter your Mobile Number");
    document.form.mob.focus();
    return false;
 }
 else if(!/^[0-9]{10}$/.test(mob)){
    alert("Enter a valid 10 digit Mobile Number");
    document.form.mob.focus();
    return false;
 }
 
 if(email == ""){
    alert("Enter your Email Id");
    document.form.email.focus();
    return false;
 }
 else if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
    alert("Enter valid email");
    document.form.email.focus();
    return false;
 }
 
 if(gender == null){
    alert("Please select your gender");
    document.form.gender.focus();
    return false;
 }
 
 if(lang.length == 0){
    alert("Please select at least one Language");
    document.form.lang.focus();
    return false;
 }
 
 if(pass == ""){
   alert("Enter your password");
   document.form.pass.focus();
   return false;
 }
 else if (!/(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])(?=.*[!@#$%^&*(),.?":{}|<>]).{8,}/.test(pass)) {
    alert("Password must contain at least one uppercase lowercase number & special character");
    document.form.pass.focus();
    return false;
}

 if(pass != confpass){
  alert("Please confirm your password");
  document.form.confpass.focus();
  return false;
 }
 else if(pass != confpass) {
   alert("Password and Confirm Password do not match");
   document.form.confpass.focus();
   return false;
 }
 
 alert("Form submitted Successfully");
 return true;
}
</script>

</body>
</html>
